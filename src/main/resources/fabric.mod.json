{
  "schemaVersion": 1,
  "id": "anubisplus",
  "version": "${version}",
  "name": "Anubis",
  "description": "Anubis is a standalone client utility mod focused on overlays, quality-of-life tooling, and advanced visual debugging.",
  "authors": [
    "4ldenz"
  ],
  "contact": {
    "homepage": "https://github.com/4ldenz/Anubis-client",
    "sources": "https://github.com/4ldenz/Anubis-client",
    "issues": "https://github.com/4ldenz/Anubis-client/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/anubis/icons/icon_128.png",
  "environment": "client",
  "mixins": [
    "anubis.mixins.json",
    {
      "config": "anubis.indigo.mixins.json",
      "environment": "client"
    }
  ],
  "entrypoints": {
    "preLaunch": [
      "net.anubis.bootstrap.AnubisNativeBootstrap"
    ],
    "client": [
      "net.anubis.client.AnubisClientMod"
    ]
  },
  "custom": {
    "modmenu": {
      "links": {}
    }
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-key-binding-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-rendering-fluids-v1": ">=2.0.0",
    "fabric-resource-loader-v0": "*",
    "fabric-screen-api-v1": "*"
  },
  "suggests": {
    "anubis-jsmacros": "*"
  },
  "breaks": {
    "embeddium": "*",
    "optifabric": "*",
    "canvas": "*",
    "vulkanmod": "*",
    "optimalaim": "<2.0.0",
    "sodium-blendingregistry": "*",
    "ocrenderfix_sodium": "*",
    "betterfpsdist": "<=1.21-4.5",
    "bobby": "<5.2.4",
    "chunksfadein": "<2.0.2-1.21.2",
    "cull-less-leaves": "<=1.3.0",
    "cullleaves": "<=3.4.0-fabric",
    "custom_hud": "<3.4.2",
    "farsight": "<=1.21-4.3",
    "iceberg": "<1.2.7",
    "movingelevators": "<=1.4.7",
    "notenoughcrashes": "<4.4.8",
    "noxesium": "<2.3.3",
    "reeses-sodium-options": "<2.0.2",
    "fabric-api": "<0.140.0",
    "sodium-extra": "<0.8.0",
    "audio_engine_tweaks": "<1.2.12",
    "sspb": "<6.0.0",
    "moreculling": "<1.6.0-beta.2",
    "simply-no-shading": "<7.6.2",
    "betterend": "<=21.0.11",
    "enchanteds_sodium_options": "<1.0.1"
  }
}
